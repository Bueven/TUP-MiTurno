{
  "name": "mi-turno-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "lighthouse": "npm run build && lhci autorun",
    "analyze": "ng build --stats-json && esbuild-visualizer --metadata dist/mi-turno-web/stats.json --filename reports/bundle-report.html",
    "start:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "build:mobile": "ng build",
    "android": "rm -rf ./android && npm run build:mobile && capacitor add android && capacitor sync android && capacitor open android"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix"
    ],
    "*.{ts,html,css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.7",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.7",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.17",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@sentry/angular": "^10.65.0",
    "@tauri-apps/api": "^2.11.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/jasmine": "^6.0.0",
    "angular-eslint": "21.4.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.1.10"
  }
}

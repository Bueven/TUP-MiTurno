{
  "name": "mi-turno-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lighthouse": "npm run build && lhci autorun",
    "analyze": "ng build --stats-json && esbuild-visualizer --metadata dist/mi-turno-web/stats.json --filename reports/bundle-report.html"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.7",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.7",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.17",
    "@sentry/angular": "^10.65.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@lhci/cli": "^0.15.1",
    "@types/jasmine": "^6.0.0",
    "esbuild-visualizer": "^0.7.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
